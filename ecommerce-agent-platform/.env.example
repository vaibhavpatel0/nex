# Halden Bazaar e-commerce agent platform. Copy to .env (git-ignored, mode 0600). Never commit real secrets.
# `make link-ecommerce` (repo root) fills AEGIS_API_TOKEN and SHOP_INTERNAL_TOKEN.
# `python scripts/configure_model.py cloud <model>` stores an Ollama key here with a hidden prompt.

SHOP_DATA_DIR=data
SHOP_DATABASE_URL=
SHOP_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
SHOP_SESSION_TTL_MINUTES=720
# Password for the synthetic test accounts. Empty: `make init` generates one and writes
# data/first-run-credentials.txt (mode 0600).
SHOP_DEMO_PASSWORD=
SHOP_LOG_LEVEL=INFO

# ---- Model (backend only; never sent to the browser)
SHOP_MODEL_PROVIDER=ollama
# Local Ollama (default, free):  OLLAMA_BASE_URL=http://127.0.0.1:11434  OLLAMA_MODEL=qwen3:8b
# Ollama cloud (billed to your Ollama plan): OLLAMA_BASE_URL=https://ollama.com  plus OLLAMA_API_KEY
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_API_KEY=
SHOP_MODEL_TIMEOUT_SECONDS=90
SHOP_MAX_MODEL_ROUNDS=6
SHOP_TOOL_TIMEOUT_SECONDS=5
SHOP_RUN_TIMEOUT_SECONDS=240
# true: staff-only tools are offered to the model so SENTINEL's denial is observable (security tests rely on it)
SHOP_EXPOSE_STAFF_TOOLS_TO_AGENT=true
# Optional OpenAI-compatible provider (SHOP_MODEL_PROVIDER=openai_compatible)
SHOP_OPENAI_BASE_URL=
SHOP_OPENAI_MODEL=
SHOP_OPENAI_API_KEY=

# ---- AEGIS AI + SENTINEL
AEGIS_BASE_URL=http://127.0.0.1:8000
AEGIS_UI_URL=http://127.0.0.1:5173
AEGIS_AGENT_KEY=shop-assistant
AEGIS_API_TOKEN=
SHOP_INTERNAL_TOKEN=
SENTINEL_TIMEOUT_SECONDS=8
