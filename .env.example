# Copy to .env and adjust. .env is git-ignored. Never commit real secrets.
# All values are optional; defaults work for local development.

# Where the SQLite database, sandboxes and reports live (relative to the repo root)
AEGIS_DATA_DIR=data
# Leave empty for SQLite in AEGIS_DATA_DIR. A PostgreSQL URL is possible but untested in this prototype.
AEGIS_DATABASE_URL=
AEGIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AEGIS_SESSION_TTL_MINUTES=720
AEGIS_APPROVAL_TTL_SECONDS=600
AEGIS_MAX_CONCURRENT_RUNS=2
AEGIS_LOG_LEVEL=INFO

# First admin account, used only by `make init` when no admin exists.
# If AEGIS_ADMIN_PASSWORD is empty, a random password is generated and printed once.
AEGIS_ADMIN_USERNAME=admin
AEGIS_ADMIN_PASSWORD=

# Ollama (optional). Local server by default. For direct cloud calls set
# OLLAMA_BASE_URL=https://ollama.com and export OLLAMA_API_KEY in your shell (not here if you share this file).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=120
# OLLAMA_API_KEY=

# Hosted OpenAI-compatible provider (optional). The key is read from the variable NAMED below.
AEGIS_HOSTED_BASE_URL=
AEGIS_HOSTED_API_KEY_ENV=AEGIS_HOSTED_API_KEY
# AEGIS_HOSTED_API_KEY=
